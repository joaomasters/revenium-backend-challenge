# Copy to .env for local Docker Compose runs. .env is git-ignored; never commit real credentials.
DB_USERNAME=usage_rating
DB_PASSWORD=change-me-local-only
# Comma-separated tenantId:apiKey pairs. Tenants must exist in the tenant table (seeded: tenant-a, tenant-b).
TENANT_API_KEYS=tenant-a:local-key-tenant-a,tenant-b:local-key-tenant-b
